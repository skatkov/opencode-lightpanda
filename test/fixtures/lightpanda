#!/usr/bin/env bun

const args = process.argv.slice(2)
const url = new URL(args[1])

if (url.pathname === "/tls-error" || url.pathname === "/dns-error") {
  process.stdout.write(JSON.stringify({
    url: url.href,
    http_status: 0,
    error: url.pathname === "/tls-error" ? "SslConnectError" : "CouldntResolveHost",
  }))
  process.stderr.write("startup notice and verbose raw failure details\n")
  process.exitCode = 1
} else if (url.pathname === "/bad-failure-json") {
  process.stdout.write("{")
  process.stderr.write(`raw failure ${"x".repeat(1000)}\nstartup notice`)
  process.exitCode = 1
} else if (url.pathname === "/empty-failure") {
  process.exitCode = 1
} else if (url.pathname === "/malformed") {
  process.stdout.write("{")
} else if (url.pathname === "/oversized") {
  process.stdout.write("x".repeat(5 * 1024 * 1024 + 1))
} else if (url.pathname === "/slow") {
  await Bun.sleep(10_000)
} else {
  process.stdout.write(
    JSON.stringify({
      url: url.href,
      http_status: url.pathname === "/not-found" ? 404 : 200,
      headers: [{ name: "Content-Type", value: "text/plain" }],
      content: url.pathname === "/command" ? JSON.stringify(args) : "fixture content",
    }),
  )
}
